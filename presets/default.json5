// 全リポジトリに当たる共通ルール。config.js が extends している。
//
// 各リポジトリの renovate.json でも同じものを extends しているが、二重に読んでも
// 結果は変わらない。リポジトリ側のファイルは「何が当たっているか」をリポジトリを
// 見ただけで分かるようにするためと、固有の設定を足す場所として置いてある。
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',

    // PR の依存更新表に Merge Confidence の全指標を出す。Age / Confidence に加えて
    // Adoption と Passing も確認できる。セルフホスト版の照会は匿名で、Mend には
    // ユーザー・リポジトリを識別する情報や依存データを送信しない:
    // https://docs.renovatebot.com/security-and-permissions/#privacy
    'mergeConfidence:all-badges',

    // 更新の一覧と、止まっている更新の理由を Issue 1本にまとめる。
    ':dependencyDashboard',

    // コミットメッセージを chore(deps): ... にする。Dependabot でも
    // prefix: chore / include: scope を使っていた。
    ':semanticCommitTypeAll(chore)',

    // Action は必ずコミット SHA で参照する。
    //
    // タグは付け替えられる。`@v1` のままにしておくと、実行されるのは「その時点で
    // 誰かがそのタグを指していた任意のコード」になる。Action は他のジョブと同じ
    // ランナーの上で、そのワークフローが持つ権限で動くので、タグの書き換えは
    // そのままトークンの流出になる。
    //
    // このプリセットが入ると、Renovate が既存の `@v1` を `@<sha> # v1` に書き換える
    // PR を出し、以後はタグの移動を digest 更新として追いかける。手で SHA を
    // 調べ直す作業は残らない。
    'helpers:pinGitHubActionDigests',

    // go.mod の `// indirect` の依存は、脆弱性があるときだけ PR を出す。
    //
    // Renovate の gomod マネージャは indirect を既定で無効にしていて、Dependency
    // Dashboard にも載らない。2026-10 に golang.org/x/net の CVE がセキュリティ
    // スキャンで見つかったとき、x/net が indirect だったリポジトリには PR が
    // 1本も出なかった。indirect を全部有効にすると、直接使っていない依存の
    // 更新 PR が毎週並ぶので、脆弱性のときだけに絞る。このプリセットは
    // indirect の通常の更新を止めたうえで、脆弱性の PR だけ force で通す。
    'security:gomodIndirectSecurityUpdates',
  ],

  // 脆弱性の情報源に OSV (osv.dev) を足す。
  //
  // 下の vulnerabilityAlerts だけだと、情報源は GitHub の Dependabot alerts
  // (GitHub Advisory Database) しかない。2026-10 の x/net の CVE は Go の
  // 脆弱性 DB には載っていたが GitHub Advisory Database には無く、アラートが
  // 0件のまま、PR は schedule どおり月曜を待っていた。セキュリティスキャン
  // (Trivy) は Go の DB を見ているので先に見つけていた。OSV は Go の DB を
  // 取り込んでいる。
  //
  // Go 本体の脆弱性もこれで拾う。go.mod の `toolchain` 行を OSV の stdlib に
  // 当てて照合する。`go` 行は言語の版でビルドに使う版ではないので照合しない。
  // setup-go が `go-version-file: go.mod` で入れる版を `toolchain` 行で決めて
  // いるのはこのため。
  osvVulnerabilityAlerts: true,

  // OSV は直接依存だけを見る。package.json の版が変わらなくても、lockfile に
  // 固定された間接依存を週次で更新する。既定の before 4am は定期実行と合わない。
  // lockfile の再解決はパッケージマネージャに委ねるため、間接依存すべてに
  // minimumReleaseAge が適用される保証はない。自動マージはしない。
  lockFileMaintenance: {
    enabled: true,
    schedule: ['on monday'],
    automerge: false,
  },

  // 上の :semanticCommitTypeAll(chore) は「semantic commit を使うなら type は chore」
  // という指定でしかない。使うかどうかは既定では自動判定で、リポジトリの既存コミットが
  // Conventional Commits で揃っているかを見る。そのため初回の実行では
  // github-terraform だけ chore(deps): が付き、他は素のタイトルになった。
  //
  // Dependabot は全リポジトリで prefix を付けていた。揃える。
  semanticCommits: 'enabled',

  timezone: 'Asia/Tokyo',

  // ワークフローは毎日走るが、PR を作るのは月曜だけ。Dependabot の weekly / monday と
  // 揃えてある。
  //
  // 時刻で絞らないのは、GitHub Actions の schedule が遅れるため。2026-09-07 は
  // 08:00 JST 起動のつもりが 09:48 JST に走り、"before 9am on monday" を外して PR が
  // 1本も出なかった。1〜2時間の遅延は普通に起きるので、時刻の窓を持たせると
  // 週によって出たり出なかったりする。曜日だけで判定する。
  schedule: ['on monday'],

  // どの依存も、公開から2週間経った版だけを対象にする。
  //
  // 侵害された版が公開されてから取り下げられるまでは、たいてい最初の数日。
  // 壊れた版にすぐ修正版が出るのも公開直後に多い。PR の表に出る Merge
  // Confidence も、公開直後は判断材料が足りず low / neutral になりやすい。
  // 以前は npm だけ7日にしていたが、グループの中で判定の低い版と高い版が
  // 混ざって、高い方だけ入れたくなることがあったので、全体で長めに待つ。
  //
  // 待っている間は PR も出ない。internalChecksFilter の既定が strict なので、
  // 期間を満たさない版は候補から外れ、1つ前の版で PR を作ることもしない。
  // 待っている更新は Dependency Dashboard に載る。
  //
  // 公開日時を返さないレジストリ (GHCR や ECR の Docker イメージなど) の更新は、
  // 既定の minimumReleaseAgeBehaviour: 'timestamp-required' によりずっと出ない。
  // そういう依存が出てきたら、その依存だけ例外にする。
  //
  // 脆弱性修正、SHA 固定、tamura09/** の digest 更新は待たない。それぞれ
  // vulnerabilityAlerts と packageRules で null に戻している。
  minimumReleaseAge: '14 days',

  // Dependabot の open-pull-requests-limit: 5 と同じ。
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  labels: ['dependencies'],

  // ベースブランチが進んだら、コンフリクトしていなくても PR を追随させる。
  //
  // 既定の rebaseWhen: 'auto' は、次のどれかに当たる PR しか追随させない。
  //   - automerge: true の PR (SHA 固定と tamura09/** の digest 更新)
  //   - ベースブランチに「マージ前に最新化を必須にする」保護がある
  //     (strict な required status checks。ruleset と旧来の branch protection の両方を見る)
  // どれにも当たらない PR (github-actions / terraform のグループや major) は
  // 'conflicted' に読み替えられ、コンフリクトするまで古いベースのまま放置される。
  // リポジトリごとの保護設定によって追随したりしなかったりするのはこのため。
  //
  // 古いベースの上で通った CI は、マージ後の状態を確かめたことにならない。
  // PR は Renovate が作ったブランチなので書き換えても失うものは無い。人が
  // コミットを足したブランチは、この設定でも Renovate は触らない。
  //
  // Renovate が見に行くのは1日2回の実行のときだけなので、追随はベースが
  // 進んだ直後ではなく次の実行で起きる。
  rebaseWhen: 'behind-base-branch',

  // 脆弱性が見つかった依存だけは schedule も待機期間も無視して先に上げる。
  // 待たせる理由が「様子を見る」ことなので、既に既知の穴が空いている場合には
  // 当てはまらない。
  vulnerabilityAlerts: {
    schedule: null,
    minimumReleaseAge: null,
  },

  packageRules: [
    // メジャーはグループに入れず個別の PR にする。破壊的変更を1つずつ読むため。
    // マイナーとパッチはまとめて1本にする。
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github-actions',
      addLabels: ['github-actions'],
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major'],
      addLabels: ['github-actions'],
    },

    // 既存の参照を SHA に固定するだけの PR は自動マージする。
    //
    // 指し先は今まさに動いているコミットで、実行されるコードは1行も変わらない。
    // 読むところが無いものを人が開いて回るのは、22 リポジトリ分あると事故の元に
    // なるだけで、判断の質は上がらない。
    //
    // schedule も外す。月曜だけ PR を出すのは更新をまとめて読むためで、読む
    // ところが無く自動でマージされるものを溜める理由が無い。固定は基本的に
    // 一度きりで、以後は digest 更新として上のグループに入る。
    //
    // 待機期間も外す。pinDigest はタグが今指している先ではなく、そのタグに合う
    // 最新版の公開日時で数えるので、2週間より短い間隔でリリースする Action は
    // いつまでも固定されない。固定しないまま待つほうがタグの書き換えに弱い。
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['pin', 'pinDigest'],
      schedule: null,
      minimumReleaseAge: null,
      automerge: true,
      addLabels: ['github-actions'],
    },

    // 自分のアカウントの Action と再利用ワークフローだけ、digest の更新も
    // 自動マージする。
    //
    // これが無いと、tamura09/pr-review を1行直すたびに、それを参照する
    // 20 リポジトリへ SHA を書き換える PR を手で出すことになる。中身は自分で
    // 書いたもので、変更そのものはあちらの PR で読んでいるので、参照を追随
    // させる PR に読むところは無い。
    //
    // 第三者の Action は含めない。他人が publish したコードを無審査で実行する
    // ことになり、SHA に固定した意味がそこで消える。第三者の分は上の
    // github-actions グループにまとまって、週1本の PR として出る。
    //
    // schedule を外してあるのは、自分の変更を全リポジトリへ届けるのに月曜まで
    // 待つ理由が無いため。出るのは自分が Action を直したときだけなので、
    // 待機期間を置かなくても PR が増え続けることはない。公開からの待機
    // (minimumReleaseAge) も同じ理由で外す。待つのは他人のリリースの様子を
    // 見るためで、自分で書いてレビューを通したものには当てはまらない。
    //
    // 自動マージなので、v1 タグを動かすと参照の切り替えは誰のレビューも通らずに
    // 全リポジトリへ届く (Renovate bot の PR は pr-review の skip_authors に
    // 入っているので、Claude のレビューも付かない)。ただしこれは今より緩くならない。
    // 今は `@v1` のままなので、タグが動いた瞬間に PR も記録も無しで参照先が
    // 変わっている。固定して digest を追う形にすると、どのコミットに変わったかが
    // PR とコミット履歴に残るぶん厳しくなる。
    //
    // タグを動かせるのはこのアカウントの書き込み権限者だけで、動かす先のコミットは
    // pr-review 側の PR でレビューを通っている。ここを本当に締めるなら、
    // 効くのは自動マージを止めることではなく、あちらのタグを保護することになる。
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['digest'],
      matchDepNames: ['tamura09/**'],
      groupName: null,
      schedule: null,
      minimumReleaseAge: null,
      automerge: true,
      addLabels: ['github-actions'],
    },
    {
      matchManagers: ['terraform', 'terraform-version'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'terraform providers',
      addLabels: ['terraform'],
    },
    {
      matchManagers: ['terraform', 'terraform-version'],
      matchUpdateTypes: ['major'],
      addLabels: ['terraform'],
    },
  ],
}
