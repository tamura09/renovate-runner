// 全リポジトリに当たる共通ルール。config.js が extends している。
//
// 各リポジトリの renovate.json でも同じものを extends しているが、二重に読んでも
// 結果は変わらない。リポジトリ側のファイルは「何が当たっているか」をリポジトリを
// 見ただけで分かるようにするためと、固有の設定を足す場所として置いてある。
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',

    // 更新の一覧と、止まっている更新の理由を Issue 1本にまとめる。
    ':dependencyDashboard',

    // コミットメッセージを chore(deps): ... にする。Dependabot でも
    // prefix: chore / include: scope を使っていた。
    ':semanticCommitTypeAll(chore)',

    // Action は必ずコミット SHA で参照する。
    //
    // タグは付け替えられる。`@v1` のままにしておくと、実行されるのは「その時点で
    // 誰かがそのタグを指していた任意のコード」になる。Action は他のジョブと同じ
    // ランナーの上で、そのワークフローが持つ権限で動くので、タグの書き換えは
    // そのままトークンの流出になる。
    //
    // このプリセットが入ると、Renovate が既存の `@v1` を `@<sha> # v1` に書き換える
    // PR を出し、以後はタグの移動を digest 更新として追いかける。手で SHA を
    // 調べ直す作業は残らない。
    'helpers:pinGitHubActionDigests',
  ],

  // 上の :semanticCommitTypeAll(chore) は「semantic commit を使うなら type は chore」
  // という指定でしかない。使うかどうかは既定では自動判定で、リポジトリの既存コミットが
  // Conventional Commits で揃っているかを見る。そのため初回の実行では
  // github-terraform だけ chore(deps): が付き、他は素のタイトルになった。
  //
  // Dependabot は全リポジトリで prefix を付けていた。揃える。
  semanticCommits: 'enabled',

  timezone: 'Asia/Tokyo',

  // ワークフローは毎日走るが、PR を作るのは月曜だけ。Dependabot の weekly / monday と
  // 揃えてある。
  //
  // 時刻で絞らないのは、GitHub Actions の schedule が遅れるため。2026-09-07 は
  // 08:00 JST 起動のつもりが 09:48 JST に走り、"before 9am on monday" を外して PR が
  // 1本も出なかった。1〜2時間の遅延は普通に起きるので、時刻の窓を持たせると
  // 週によって出たり出なかったりする。曜日だけで判定する。
  schedule: ['on monday'],

  // Dependabot の open-pull-requests-limit: 5 と同じ。
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  labels: ['dependencies'],

  // 脆弱性が見つかった依存だけは schedule も待機期間も無視して先に上げる。
  // 待たせる理由が「様子を見る」ことなので、既に既知の穴が空いている場合には
  // 当てはまらない。
  vulnerabilityAlerts: {
    schedule: null,
    minimumReleaseAge: null,
  },

  packageRules: [
    // npm はサプライチェーン攻撃の踏み台にされやすい。侵害された版が公開されて
    // から取り下げられるまでは、たいてい最初の数日。そこに触らないよう、出てから
    // 1週間経った版だけを対象にする。
    //
    // 待っている間は PR も出ない。internalChecksFilter の既定が strict なので、
    // 期間を満たさない版は候補から外れ、1つ前の版で PR を作ることもしない。
    {
      matchManagers: ['npm'],
      minimumReleaseAge: '7 days',
    },

    // メジャーはグループに入れず個別の PR にする。破壊的変更を1つずつ読むため。
    // マイナーとパッチはまとめて1本にする。
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github-actions',
      addLabels: ['github-actions'],
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major'],
      addLabels: ['github-actions'],
    },

    // 既存の参照を SHA に固定するだけの PR は自動マージする。
    //
    // 指し先は今まさに動いているコミットで、実行されるコードは1行も変わらない。
    // 読むところが無いものを人が開いて回るのは、22 リポジトリ分あると事故の元に
    // なるだけで、判断の質は上がらない。
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['pin', 'pinDigest'],
      automerge: true,
      addLabels: ['github-actions'],
    },

    // 自分のアカウントの Action と再利用ワークフローだけ、digest の更新も
    // 自動マージする。
    //
    // これが無いと、tamura09/claude-pr-review を1行直すたびに、それを参照する
    // 20 リポジトリへ SHA を書き換える PR を手で出すことになる。中身は自分で
    // 書いたもので、変更そのものはあちらの PR で読んでいるので、参照を追随
    // させる PR に読むところは無い。
    //
    // 第三者の Action は含めない。他人が publish したコードを無審査で実行する
    // ことになり、SHA に固定した意味がそこで消える。第三者の分は上の
    // github-actions グループにまとまって、週1本の PR として出る。
    //
    // schedule を外してあるのは、自分の変更を全リポジトリへ届けるのに月曜まで
    // 待つ理由が無いため。出るのは自分が Action を直したときだけなので、
    // 待機期間を置かなくても PR が増え続けることはない。
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['digest'],
      matchDepNames: ['tamura09/**'],
      groupName: null,
      schedule: null,
      automerge: true,
      addLabels: ['github-actions'],
    },
    {
      matchManagers: ['terraform', 'terraform-version'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'terraform providers',
      addLabels: ['terraform'],
    },
    {
      matchManagers: ['terraform', 'terraform-version'],
      matchUpdateTypes: ['major'],
      addLabels: ['terraform'],
    },
  ],
}
